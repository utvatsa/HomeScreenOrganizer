<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional read-only usage ranking for the Most Used readiness check (user-granted in Settings). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Unlocked home screen wallpaper application only (FLAG_SYSTEM; lock screen is never modified). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Narrowly scoped package & launcher visibility queries only; no QUERY_ALL_PACKAGES, INTERNET, or storage permissions. -->
    <queries>
        <package android:name="com.sec.android.app.launcher" />
        <package android:name="com.samsung.android.goodlock" />
        <package android:name="com.samsung.android.app.homestar" />
        <package android:name="com.sec.android.easyMover" />
        <package android:name="org.kustom.widget" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name" />

        <activity-alias
            android:name=".ui.LauncherWarmPaper"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_warm_paper"
            android:roundIcon="@mipmap/ic_launcher_warm_paper"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.LauncherSamsungBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_samsung_blue"
            android:roundIcon="@mipmap/ic_launcher_samsung_blue"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.LauncherNordicOlive"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nordic_olive"
            android:roundIcon="@mipmap/ic_launcher_nordic_olive"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.LauncherCopperEspresso"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_copper_espresso"
            android:roundIcon="@mipmap/ic_launcher_copper_espresso"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.LauncherPacificCobalt"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pacific_cobalt"
            android:roundIcon="@mipmap/ic_launcher_pacific_cobalt"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.LauncherSunlitOchre"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sunlit_ochre"
            android:roundIcon="@mipmap/ic_launcher_sunlit_ochre"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.LauncherArcticChrome"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_arctic_chrome"
            android:roundIcon="@mipmap/ic_launcher_arctic_chrome"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.CategoryHeaderWidgetProvider"
            android:exported="true"
            android:label="@string/header_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/category_header_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WallpaperPlaceholderWidgetProvider"
            android:exported="true"
            android:label="@string/placeholder_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wallpaper_placeholder_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WallpaperSpacer1x1Provider"
            android:exported="true"
            android:label="@string/placeholder_1x1_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wallpaper_spacer_1x1_info" />
        </receiver>

    </application>

</manifest>
